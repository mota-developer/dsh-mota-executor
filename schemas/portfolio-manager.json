                  "take_profit_trigger_price": {
                    "type": "number"
                  },
                  "take_profit_order_style": {
                    "type": "string",
                    "enum": [
                      "MARKET",
                      "LIMIT"
                    ]
                  },
                  "take_profit_limit_price": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "止盈 style 为 MARKET 时为 null。"
                  },
                  "stop_loss_trigger_price": {
