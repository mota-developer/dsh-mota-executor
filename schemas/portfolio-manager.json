                "RISK_OVERRIDE",
                "REBALANCE",
                "NO_ACTION",
                "OTHERS"
              ]
            },
            "orders": {
              "type": "array",
              "description": "建议订单。与 target_allocation 至少一项非空，由本分支的 anyOf 强制；NO_ACTION 也不豁免——不操作须以非空 target_allocation 表达「维持现状」，与评测断言 PM_HAS_DECISION 同口径。market / order_type 在产品契约里属职能二字段，此处同样强制——平台对任何 payload_result.orders[] 都按订单契约解析。",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "market": {
                    "type": "string",
                    "enum": [
                      "US",
                      "HK",
                      "CN"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "BUY",
                      "SELL"
                    ]
                  },
                  "order_type": {
                    "type": "string",
                    "enum": [
                      "MARKET",
                      "LIMIT"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "reasoning": {
                    "type": "string"
                  },
                  "limit_price": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "weight_delta_pct": {
                    "type": "number"
                  }
                },
                "required": [
                  "symbol",
                  "market",
                  "direction",
                  "order_type",
                  "quantity",
                  "reasoning"
                ]
              }
            },
            "target_allocation": {
              "type": "array",
              "description": "目标配置。与 orders 至少一项非空。",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "target_weight_pct": {
                    "type": "number"
                  },
                  "reasoning": {
                    "type": "string"
                  },
                  "stance": {
                    "type": "string",
                    "enum": [
                      "OVERWEIGHT",
                      "NEUTRAL",
                      "UNDERWEIGHT"
                    ]
                  },
                  "current_weight_pct": {
                    "type": "number"
                  }
                },
                "required": [
                  "symbol",
                  "target_weight_pct",
                  "reasoning"
                ]
              }
            },
            "rationale": {
              "type": "string",
              "description": "综合决策依据"
            },
            "constraints_applied": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk_handoff": {
              "type": "string"
            },
            "evidenceRefs": {
              "type": "array",
              "description": "GRD-6 证据引用。注意键名是 camelCase（平台校验器 EvidenceRefsValidator 按此键名读取），与 payload_result 内其余 snake_case 字段不同。",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sourceType": {
                    "type": "string",
                    "examples": [
                      "MCP_TOOL",
                      "UPSTREAM",
                      "DOC"
                    ]
                  },
                  "sourceId": {
                    "type": "string",
                    "examples": [
                      "quotation.get_snapshot"
                    ]
                  },
                  "asOf": {
                    "type": "string",
                    "examples": [
                      "2026-07-28"
                    ]
                  }
                },
                "required": [
                  "sourceType",
                  "sourceId"
                ]
              }
            },
            "extensions": {
              "type": "array",
              "description": "上述字段装不下的扩展信息。"
            }
          },
          "required": [
            "decision_type",
            "rationale"
          ],
          "anyOf": [
            {
              "title": "给了建议订单",
              "required": [
