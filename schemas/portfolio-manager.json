    "payloadResult": {
      "title": "③-a 岗位载荷 payload_result（PORTFOLIO_MANAGER，V2 岗位输出契约 · 双职能）",
      "description": "本岗按入站 runtime_context.is_final 二选一输出：缺省 / false = 职能一（团队过程中的 PM，配置决策）；true = 职能二（final 岗位，完整订单信号）。两个分支的 required 集不同，故用 oneOf 表达。",
      "oneOf": [
        {
          "title": "职能一 · 团队过程中的 PM（is_final 缺省或 false）",
          "type": "object",
          "properties": {
            "decision_type": {
              "type": "string",
              "enum": [
                "STANDALONE",
                "MULTI_SOURCE_CONSENSUS",
