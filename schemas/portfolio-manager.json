            "evidenceRefs": {
              "type": "array",
              "description": "GRD-6 证据引用。注意键名是 camelCase（平台校验器 EvidenceRefsValidator 按此键名读取），与 payload_result 内其余 snake_case 字段不同。",
              "minItems": 1,
