                    ]
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "todayOrders": {
              "type": [
                "array",
                "null"
              ],
              "description": "当前运行账户的当日订单；字段语义与交易域 MCP get_today_orders 一致。",
              "items": {
                "type": "object",
                "properties": {
