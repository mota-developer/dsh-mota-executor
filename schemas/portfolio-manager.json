                  "order_type": {
                    "type": "string",
                    "enum": [
                      "MARKET",
                      "LIMIT"
                    ]
                  },
                  "limit_price": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "LIMIT 单必须为正数；MARKET 单为 null。"
