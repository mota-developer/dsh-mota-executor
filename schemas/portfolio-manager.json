    "motaAgentPayloadV1": {
      "title": "③ Hermes 容器 stdout 输出 mota-agent-payload v1",
      "description": "Agent 全部输出必须是单个 JSON 对象——第一个字符 {、最后一个字符 }，无 markdown 围栏、无解释性前后缀。无法完成任务时同样输出该结构：payload_info 说明原因，payload_result 给保守缺省结构。落库进 agent_run.result_json。",
      "type": "object",
      "properties": {
        "payload_result": {
          "$ref": "#/$defs/payloadResult"
        },
        "payload_info": {
          "type": "string",
          "description": "非空的人读业务摘要，输出语言随 globalParameters.language。"
        },
        "contract_version": {
          "type": "string",
          "const": "V2",
          "description": "本次输出遵循的岗位契约版本（输出自描述）。下游据此决定按哪套 schema 解析 payload_result——与制品版本（creator_agent_version.version，如 v2.1.0）是两个维度：制品版本用于溯源「哪家的第几版」，本字段用于解析。Bound 模式下平台没有创作者的 profile，只有输出自报才知道对方实现的是哪版契约，故为必填。自 profile v2.1.0 起产出；v2.0.0 的输出不带本字段。"
        }
      },
      "required": [
        "payload_result",
        "payload_info",
        "contract_version"
      ],
      "additionalProperties": false
    },
