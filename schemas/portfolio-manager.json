            {
              "title": "给了目标配置",
              "required": [
                "target_allocation"
              ],
              "properties": {
                "target_allocation": {
                  "minItems": 1
                }
              }
            }
          ],
          "additionalProperties": false
        },
        {
          "title": "职能二 · final 岗位（runtime_context.is_final = true）",
          "description": "落单硬约束（平台侧 WorkflowSignalOrderSchema v1 逐单校验，违反判 ORDER_OUTPUT_INVALID）：quantity 为正整数；market 必填且与标的后缀一致；order_type=LIMIT 时 limit_price 为正数、MARKET 时为 null；止盈/止损 order style 为 MARKET 时对应 limit_price 为 null。",
          "type": "object",
          "properties": {
