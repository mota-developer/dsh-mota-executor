    "motaSseEventData": {
      "title": "⑤ SSE 事件 data 体（POST /tqx/api/v1/agent/invoke，text/event-stream）",
      "description": "事件类型 progress | done | error；流末尾固定 `data: [DONE]`。响应头 X-Mota-Agent-Instance-Id 先于首个事件返回（MoTA 侧 initTimeout 默认 20s 等的就是它）。Hosted 无原生事件流，由 HostedTqxExecutor 轮询 DB 合成。",
      "type": "object",
      "properties": {
        "agent_instance_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/statusCode"
        },
        "state": {
          "$ref": "#/$defs/stateName"
        },
        "progress": {
          "description": "进度信息（可选）"
        },
        "error": {
          "type": "string",
          "description": "仅 error 事件；失败原因"
        },
        "payload_result": {
          "type": [
            "object",
            "null"
          ],
          "description": "仅终态事件"
        },
        "payload_info": {
          "type": [
            "string",
            "null"
          ],
          "description": "仅终态事件"
        }
      },
      "required": [
        "agent_instance_id",
        "status",
        "state"
      ]
    },
    "statusCode": {
      "type": "integer",
      "description": "1=运行中；-1=终态成功；2=终态失败。终态判定 status<0 || status==2；失败判定 status==2 || status<-1（doc/97 §5.3，各 developer 通道共用）。",
      "examples": [
        1,
        -1,
        2
      ]
    },
    "stateName": {
      "type": "string",
      "enum": [
        "running",
        "done",
        "failed"
      ],
      "description": "Hosted 侧取值集；MoTA 的 state 归一判定另接受 complete/completed/success/succeeded/error/blocked 等同义词。"
    }
  }
