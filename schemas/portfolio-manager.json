    "x-mota-templateParameters": {
      "title": "本岗位 templateInputData 可用参数（name → 取值约定）",
      "description": "来源 SOUL.md「payload_result 载荷契约」节末的模板参数说明——本岗位参数即风控约束，Agent 必须逐条遵守并在 rationale / report_markdown 中核对。完整 allowed_values 事实源仍在 TQX 目录（GET /agent/schema/get），creator 侧不伪造。",
      "type": "object",
      "properties": {
        "single_name_max_pct_nav": {
          "type": "number",
          "description": "单一标的占 NAV 上限（%）"
        },
        "industry_max_pct_nav": {
          "type": "number",
          "description": "单一行业占 NAV 上限（%）"
        },
        "min_cash_buffer_pct": {
          "type": "number",
