{
  "name": "dsh-mota-executor",
  "version": "0.2.1",
  "description": "Multi-Agent MoTA Creator connector for DeepSeek Harness: several bound Pull Agents, per-Agent queue/concurrency, usage and cost stats, logs.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "schemas",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/",
    "verify:index": "node scripts/verify-index.mjs",
    "prepublishOnly": "npm test && node scripts/verify-index.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mota",
    "mota-creator",
    "agent",
    "worker"
  ],
  "author": "mota-developer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mota-developer/dsh-mota-executor.git"
  },
  "homepage": "https://github.com/mota-developer/dsh-mota-executor#readme",
  "bugs": {
    "url": "https://github.com/mota-developer/dsh-mota-executor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
